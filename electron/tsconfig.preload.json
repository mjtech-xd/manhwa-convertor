{
  // Preload runs in a sandboxed renderer context, which only supports
  // CommonJS — it cannot be ESM like the rest of the main process. Emitted
  // separately to dist-electron/preload/ with its own type:commonjs marker.
  "compilerOptions": {
    "target": "ES2022",
    // Preload runs in the renderer process, so DOM globals (MessageChannel,
    // MessagePort) are available and used by the streaming IPC transport.
    "lib": ["ES2022", "DOM"],
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "../dist-electron",
    "rootDir": ".",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["preload/**/*.ts"],
  "exclude": ["**/*.spec.ts", "node_modules"]
}
